# IncidentPilot Environment Configuration

# Engine Mode: "live" (calls real LLM) or "replay" (deterministic offline mode for zero-key judge evaluation)
ENGINE_MODE=replay

# LLM Providers (Required only if ENGINE_MODE=live)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Switch Core / Agent Bridge Connection
SWITCH_BRIDGE_URL=http://localhost:8000
SWITCH_ROOM_ID=sre-incident-war-room
AGENT_REGISTRATION_TOKEN=
COMMANDER_API_KEY=
DIAGNOSTICIAN_API_KEY=
DEBUGGER_API_KEY=
CRITIC_API_KEY=

# Target Sandbox Environment (Non-colliding host ports)
ORDERS_API_URL=http://localhost:8080
PROMETHEUS_URL=http://localhost:9090
REDIS_URL=redis://localhost:16379
DATABASE_URL=postgresql://orders:orders@localhost:5433/orders

# Safety & Governance
REQUIRE_HUMAN_APPROVAL=true
CIRCUIT_BREAKER_MAX_FAILURES=3
EXECUTION_TIMEOUT_SECONDS=30

